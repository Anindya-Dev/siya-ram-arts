# =============================================================================
# Siya Ram Arts — Environment Variables Reference
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Production: Supabase Postgres (asyncpg driver)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Dev-only SQLite fallback (used by tests when DATABASE_URL is not set):
# DATABASE_URL=sqlite+aiosqlite:///./siyaramarts.db

# -----------------------------------------------------------------------------
# SUPABASE (Storage + optional JS SDK use)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION (JWT verification + RBAC)
# Get from: https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENTS
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# IMAGEKIT (CDN image transforms — optional if using Supabase Storage directly)
# Get from: https://imagekit.io/dashboard → Developer Options
# -----------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# -----------------------------------------------------------------------------
# SHIPROCKET (Logistics — covers DTDC, Delhivery, BlueDart, DHL, FedEx, etc.)
# Get from: https://app.shiprocket.in → Settings → API
# -----------------------------------------------------------------------------
SHIPROCKET_EMAIL=your_shiprocket_account_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_account_password

# -----------------------------------------------------------------------------
# ADMIN ACCESS
# Comma-separated list of email addresses that are granted admin access
# (server-side whitelist checked by /api/v1/auth/verify-admin)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@siyaramarts.com,owner@siyaramarts.com

# -----------------------------------------------------------------------------
# APM / ERROR TRACKING (optional but recommended for production)
# Get from: https://sentry.io → Settings → Projects → Client Keys
# -----------------------------------------------------------------------------
SENTRY_DSN=https://YOUR_SENTRY_KEY@oXXXXXX.ingest.sentry.io/XXXXXXXX

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_URL=https://siyaramarts.com
ENVIRONMENT=production
# Set to "development" locally; "test" is set automatically by pytest.
# ENVIRONMENT=development

# =============================================================================
# ⚠️  PRODUCTION INFRASTRUCTURE NOTES
# =============================================================================
#
# WeasyPrint (PDF invoices) requires native GTK/Pango C libraries.
# On Ubuntu/Debian production servers or Docker images, install before deploying:
#   apt-get install -y libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
#     libcairo2 libcairo-gobject2 libgdk-pixbuf2.0-0 libffi-dev
# On Windows dev machines: WeasyPrint will catch the OSError, set pdf_status=failed,
# and continue — no crash. Re-trigger PDF via POST /api/v1/invoices/{id}/regenerate.
#
# Redis (optional): Used for rate-limiting or caching if added later.
#   REDIS_URL=redis://localhost:6379/0
#
# Production target stack:
#   Database  → Supabase Postgres (already provisioned)
#   Storage   → Supabase Storage buckets for idol images
#   Auth      → Clerk (keep; do NOT add Supabase Auth in parallel)
#   Backend   → FastAPI on a Linux host or Docker container with GTK libs
#   CDN/Transforms → ImageKit or Supabase CDN
#   APM       → Sentry (optional)
#   Caching   → Redis (optional, for future rate-limiting)
# =============================================================================
